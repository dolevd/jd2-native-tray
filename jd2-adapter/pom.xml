<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.jdownloader.extensions.nativetray</groupId>
    <artifactId>jd2-native-tray</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>jd2-adapter</artifactId>
  <name>JDownloader Native Tray extension</name>
  <dependencies>
    <dependency>
      <groupId>org.jdownloader.extensions.nativetray</groupId>
      <artifactId>tray-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jdownloader.local</groupId>
      <artifactId>core</artifactId>
      <version>local</version>
      <scope>system</scope>
      <systemPath>${jd.install.dir}/Core.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.jdownloader.local</groupId>
      <artifactId>launcher</artifactId>
      <version>local</version>
      <scope>system</scope>
      <systemPath>${jd.install.dir}/JDownloader.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.jdownloader.local</groupId>
      <artifactId>utils</artifactId>
      <version>local</version>
      <scope>system</scope>
      <systemPath>${jd.install.dir}/libs/JDUtils.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.jdownloader.local</groupId>
      <artifactId>gui</artifactId>
      <version>local</version>
      <scope>system</scope>
      <systemPath>${jd.install.dir}/libs/JDGUI.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.jdownloader.local</groupId>
      <artifactId>jna</artifactId>
      <version>local</version>
      <scope>system</scope>
      <systemPath>${jd.install.dir}/libs/jna.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.jdownloader.local</groupId>
      <artifactId>jna-platform</artifactId>
      <version>local</version>
      <scope>system</scope>
      <systemPath>${jd.install.dir}/libs/jna_platform.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.12.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.17</version>
    </dependency>
  </dependencies>
  <build>
    <finalName>NativeTray</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <relocations>
                <relocation>
                  <pattern>org.freedesktop.dbus</pattern>
                  <shadedPattern>org.jdownloader.extensions.nativetray.vendor.dbus</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.slf4j</pattern>
                  <shadedPattern>org.jdownloader.extensions.nativetray.vendor.slf4j</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/**/module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <properties>
    <!-- JD2/AppWork's extension APIs are supplied by the installed application. -->
    <jd.install.dir>${user.home}/.var/app/org.jdownloader.JDownloader/data/jdownloader</jd.install.dir>
  </properties>
  <profiles>
    <profile>
      <id>custom-jd2-installation</id>
      <activation>
        <property>
          <name>env.JD2_INSTALL_DIR</name>
        </property>
      </activation>
      <properties>
        <jd.install.dir>${env.JD2_INSTALL_DIR}</jd.install.dir>
      </properties>
    </profile>
  </profiles>
</project>
